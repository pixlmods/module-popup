<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pixlmods_report_listing.pixlmods_report_listing_data_source</item>
            <item name="deps" xsi:type="string">pixlmods_report_listing.pixlmods_report_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>pixlmods_report_columns</spinner>
        <deps>
            <dep>pixlmods_report_listing.pixlmods_report_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="pixlmods_report_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>PixlMods_Popup::popup</aclResource>
        <dataProvider class="PixlMods\Popup\Ui\Component\Report\DataProvider" name="pixlmods_report_listing_data_source">
            <settings>
                <primaryFieldName>entity_id</primaryFieldName>
                <requestFieldName>entity_id</requestFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="pixlmods_report_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Popup Id</label>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Popup Title</label>
            </settings>
        </column>
        <column name="views" sortOrder="30">
            <settings>
                <filter>false</filter>
                <sortable>true</sortable>
                <label translate="true">Views</label>
            </settings>
        </column>
        <column name="closes" sortOrder="40">
            <settings>
                <filter>false</filter>
                <sortable>true</sortable>
                <label translate="true">Closes</label>
            </settings>
        </column>
        <column name="conversions" sortOrder="50">
            <settings>
                <filter>false</filter>
                <sortable>true</sortable>
                <label translate="true">Conversions</label>
            </settings>
        </column>
        <column name="conversion_rate" sortOrder="60">
            <settings>
                <filter>false</filter>
                <sortable>true</sortable>
                <label translate="true">Conversion Rate (%)</label>
            </settings>
        </column>
    </columns>
</listing>
