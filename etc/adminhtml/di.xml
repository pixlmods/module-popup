<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/di.xsd">
    <type name="PixlMods\Popup\Block\Adminhtml\Popup\Edit">
        <arguments>
            <argument name="registry" xsi:type="object">Magento\Framework\Registry</argument>
            <argument name="formFactory" xsi:type="object">Magento\Framework\Data\FormFactory</argument>
        </arguments>
    </type>
    <type name="PixlMods\Popup\Controller\Adminhtml\Popup\Save">
        <arguments>
            <argument name="popupFactory" xsi:type="object">PixlMods\Popup\Model\PopupFactory</argument>
        </arguments>
    </type>

    <!-- Applies grid filters/sorting/paging (from the UI Component request) onto our plain collections -->
    <virtualType name="PixlMods\Popup\Model\Api\SearchCriteria\CollectionProcessor" type="Magento\Framework\Api\SearchCriteria\CollectionProcessor">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="filters" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\FilterProcessor</item>
                <item name="sorting" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\SortingProcessor</item>
                <item name="pagination" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\PaginationProcessor</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="PixlMods\Popup\Ui\Component\Listing\DataProvider">
        <arguments>
            <argument name="collectionProcessor" xsi:type="object">PixlMods\Popup\Model\Api\SearchCriteria\CollectionProcessor</argument>
        </arguments>
    </type>
    <type name="PixlMods\Popup\Ui\Component\Report\DataProvider">
        <arguments>
            <argument name="collectionProcessor" xsi:type="object">PixlMods\Popup\Model\Api\SearchCriteria\CollectionProcessor</argument>
        </arguments>
    </type>
</config>
